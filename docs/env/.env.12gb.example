# ─────────────────────────────────────────────────────────────────────────────
# Aria .env — 12 GB VRAM + INT4 model (e.g. RTX 3060 12GB, RTX 4070)
#
# VRAM budget:
#   Model weights (INT4, 9B): ~5 GB
#   CUDA/runtime overhead:    ~1.5 GB
#   KV cache (fp8):           ~4.8 GB → 32K context fits comfortably
#   Total:                    ~11.3 GB of 12 GB
# ─────────────────────────────────────────────────────────────────────────────

DEBUG = true  # Set to false to reduce logging verbosity

# Server basics
SERVER_HOST = 0.0.0.0
SERVER_PORT = 9876
CHAINLIT_AUTH_SECRET =          # auto-generated on first run

# Agent loop safety and per-request caps
MAX_ITERATIONS = 100
TOKEN_LIMIT_RATIO = 0.35  # 35% of CHAT_CONTEXT_SIZE for memory; leaves ~65% for system prompt + tools + response
CHAT_HISTORY_TOKEN_RATIO = 0.50

# Chat service and model — 5 GB INT4 model for 12 GB VRAM
CHAT_OPENAI_API = http://localhost:9090/v1
CHAT_MODEL = Qwen3.8-9B
CHAT_MODEL_PATH = malvavisc0/Qwen3.8-9B-gptq-int4
CHAT_CONTEXT_SIZE = 32768
CHAT_TEMPLATE_FILE =       # Leave empty to use the model's built-in chat template

# Embeddings (CPU-only, ~600 MB RAM — no VRAM impact)
EMBEDDINGS_MODEL = granite-embedding-english-r2
EMBED_MODEL_PATH = ibm-granite/granite-embedding-english-r2
EMBEDDINGS_CONTEXT_SIZE = 4096

# vLLM engine — tuned for 12 GB VRAM + INT4 model
ARIA_VLLM_GPU_MEMORY_UTILIZATION =      # auto-calculated at launch
ARIA_VLLM_QUANT = gptq_marlin
ARIA_VLLM_TP_SIZE = 1
ARIA_VLLM_DTYPE = auto
ARIA_VLLM_KV_CACHE_DTYPE = fp8
ARIA_VLLM_API_KEY = sk-aria
ARIA_VLLM_TOOL_CALL_PARSER = qwen3_xml
ARIA_VLLM_REASONING_PARSER = qwen3
ARIA_VLLM_CHAT_TEMPLATE_KWARGS = {"enable_thinking": true, "preserve_thinking": false}
ARIA_VLLM_VISION_ENABLED = true
ARIA_VLLM_DATA_PARALLEL_SIZE = 1
ARIA_VLLM_EXPERT_PARALLEL =
ARIA_VLLM_MM_ENCODER_TP_MODE =
ARIA_VLLM_MM_PROCESSOR_CACHE_TYPE =
ARIA_VLLM_PREFIX_CACHING = true

# Cap concurrent decode sequences below the Mamba cache block limit
# (vLLM default 256 > available on 12 GB VRAM → graph capture fails).
ARIA_VLLM_MAX_NUM_SEQS = 10

# KV cache offloading
ARIA_VLLM_KV_OFFLOAD_MODE = off
ARIA_VLLM_KV_OFFLOADING_BACKEND = native

# Max tokens — proportional to 32K context
ARIA_MAX_TOKENS = 8192

# LLM sampling parameters
ARIA_VLLM_TEMPERATURE = 0.6
ARIA_VLLM_TOP_P = 0.95
ARIA_VLLM_TOP_K = 20
ARIA_VLLM_MIN_P = 0.05
ARIA_VLLM_PRESENCE_PENALTY = 0.0
ARIA_VLLM_REPETITION_PENALTY = 1.05
ARIA_VLLM_SEED = 42
# Reasoning effort for thinking models (low/medium/high/none; blank to omit).
ARIA_VLLM_REASONING_EFFORT = low

# Paths and persistence
ARIA_DB_FILENAME = aria.db
CHROMADB_PERSISTENT_PATH = chromadb
HF_TOKEN =

# Lightpanda browser (optional — browser tools disabled if not installed)
LIGHTPANDA_VERSION = nightly
LIGHTPANDA_PORT = 9222

# CUDA settings
CUDA_MODULE_LOADING = LAZY
